---
layout: null
---
{
  "actualizado": "{{ site.time | date_to_xmlschema }}",
  "reflexiones": [
    {% for post in site.posts %}{
      "id": {{ post.id | jsonify }},
      "titulo": {{ post.title | jsonify }},
      "autor": {{ post.autor | default: "ETNOGRAPP" | jsonify }},
      "afiliacion": {{ post.afiliacion | default: "" | jsonify }},
      "fecha": "{{ post.date | date: '%Y-%m-%d' }}",
      "resumen": {{ post.resumen | default: post.excerpt | strip_html | strip_newlines | truncate: 220 | jsonify }},
      "url": {{ post.url | absolute_url | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
